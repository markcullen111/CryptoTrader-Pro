# CryptoTrader Pro Configuration Template
# Copy this file to config.yaml and update with your settings

exchange:
  name: binance
  api_key: ""  # Set in .env file
  api_secret: ""  # Set in .env file
  testnet: false  # Set to true for testing

database:
  # SQLite configuration (default)
  type: sqlite
  path: data/cryptotrader.db

  # PostgreSQL configuration (optional)
  # type: postgresql
  # host: localhost
  # port: 5432
  # name: cryptotrader
  # user: cryptotrader
  # password: your_secure_password

trading:
  default_symbol: "BTC/USDT"
  default_timeframe: "1h"
  risk_per_trade: 0.02  # 2% risk per trade
  max_positions: 5
  default_leverage: 1  # 1x leverage (spot trading)
  
risk_management:
  max_drawdown: 0.1  # 10% maximum drawdown
  stop_loss: 0.02    # 2% stop loss
  take_profit: 0.04  # 4% take profit
  trailing_stop: 0.01  # 1% trailing stop

data_storage:
  market_data_dir: data/market_data
  models_dir: data/models
  backtest_dir: data/backtest
  experiments_dir: data/experiments

logging:
  level: INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
  file: logs/app.log
  max_size: 10485760  # 10MB
  backup_count: 5

ui:
  theme: dark  # dark or light
  refresh_rate: 5  # seconds
  default_page: dashboard

ml_models:
  feature_engineering:
    window_sizes: [14, 30, 50]
    indicators:
      - RSI
      - MACD
      - Bollinger
  training:
    test_size: 0.2
    cv_folds: 5
    max_trials: 100 