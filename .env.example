# Environment variables for Crypto Trading Bot

# Trading bot mode (paper or live)
TRADING_BOT_MODE=paper

# Debug mode (set to 1 to enable)
TRADING_BOT_DEBUG=0

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TRADING_BOT_LOG_LEVEL=INFO

# Exchange API credentials (required for live trading)
# WARNING: Never commit your actual API keys to version control!
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# MLflow configuration
MLFLOW_TRACKING_URI=http://localhost:5000

# Selected strategies (comma-separated)
TRADING_BOT_STRATEGIES=rsi,macd,bollinger

# Database connection (optional)
# DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Binance API Configuration
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Database Configuration (Optional - if not using config.yaml)
DB_TYPE=sqlite  # or postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptotrader
DB_USER=cryptotrader
DB_PASSWORD=your_secure_password

# Application Settings
APP_ENV=production  # production or development
DEBUG=false
LOG_LEVEL=INFO

# Security Settings
JWT_SECRET=generate_a_secure_random_string
ENCRYPTION_KEY=generate_a_secure_random_string

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id 